{
  "name": "dsh-pwnvader-wallpapers",
  "version": "1.0.0",
  "type": "module",
  "description": "Independent animated wallpapers and local media for DeepSeek Harness",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "licenses",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "VALIDACION.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wallpapers",
    "animation",
    "offline",
    "wallpaper"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/core.test.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "author": "pwnVader",
  "packageManager": "pnpm@11.7.0"
}
